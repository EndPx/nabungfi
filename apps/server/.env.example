# Server-only values. Copy locally to .env, which is ignored by Git.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=

NABUNGFI_API_HOST=127.0.0.1
NABUNGFI_API_PORT=3001
# Hosting providers may set PORT; it takes precedence over NABUNGFI_API_PORT.
NABUNGFI_WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Production requires NODE_ENV=production and explicit HTTPS origin(s).
# Bind 0.0.0.0 only behind an HTTPS reverse proxy/container ingress.
NABUNGFI_KEEPER_REGISTRY_FILE=
NABUNGFI_KEEPER_STATUS_FILE=

# Separate local simulator: no Privy, Neon or wallets.
NABUNGFI_DEMO_PORT=3002
