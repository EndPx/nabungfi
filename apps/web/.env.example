# Optional development instrumentation control.
VITE_DISABLE_REACT_DEVTOOLS=1
# Public Privy application ID. Never place a secret or database URL here.
VITE_PRIVY_APP_ID=
# Empty for a same-origin API or the local Vite proxy. Set an HTTPS API origin for a separate host.
# The API must explicitly allow the deployed frontend origin in its CORS allowlist.
VITE_API_ORIGIN=
