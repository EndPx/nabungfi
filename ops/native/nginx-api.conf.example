# Dedicated vhost only: do not replace nginx.conf or another app's site.
# Install AFTER DNS and this certificate exist; nginx -t must pass before a reload.
server {
    listen 80;
    server_name nabungfi-api.endpx.cloud;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/nabungfi-acme;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name nabungfi-api.endpx.cloud;
    ssl_certificate /etc/letsencrypt/live/nabungfi-api.endpx.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nabungfi-api.endpx.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    client_header_timeout 15s;
    client_body_timeout 30s;
    location /api/ {
        proxy_pass http://127.0.0.1:3901;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 35s;
        proxy_cache off;
        # Never retry an action request against another upstream after an ambiguous response.
        proxy_next_upstream off;
    }
    location / { return 404; }
}
