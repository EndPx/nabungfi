# Install as /etc/nabungfi/api.env, root:nabungfi-api 0640. No real secrets in the release.
NODE_ENV=production
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=
PORT=3901
NABUNGFI_API_HOST=127.0.0.1
# Exact frontend origins only. Final DNS/Privy/Vercel configuration is a separate deployment gate.
NABUNGFI_WEB_ORIGIN=https://nabungfi.endpx.cloud
NABUNGFI_KEEPER_REGISTRY_FILE=/var/lib/nabungfi/.local/registry/goals.json
NABUNGFI_KEEPER_STATUS_FILE=/var/lib/nabungfi/.local/status/operator-status.json
