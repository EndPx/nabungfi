                "docs": [
                  "Account list for the custom instruction",
                  "Uses same AddressLocator system as LzReceive"
                ],
                "type": {
                  "vec": {
                    "defined": {
                      "name": "AccountMetaRef"
                    }
                  }
                }
              },
              {
